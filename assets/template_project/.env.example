# 环境变量示例：复制为 .env 或在执行前 set（Windows）/ export（Linux）
# 被测系统地址（demo 应用经 start_demo.py 启动）
BASE_URL=http://127.0.0.1:8765
# 浏览器引擎：playwright | selenium
BROWSER_ENGINE=playwright
# 无头模式
HEADLESS=true
# 日志级别
LOG_LEVEL=INFO
# 演示账号（断言期望值）
DEMO_USER=admin
DEMO_PASSWORD=123456
# 元素级超时（毫秒）
DEFAULT_TIMEOUT_MS=10000
